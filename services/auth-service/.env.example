# auth-service environment (no secrets committed).
# In Docker Compose the shared Laravel environment file is provided by the
# deployment; only the keys below are required by this service.
APP_NAME=RifaCloud
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# S11: must match the monolith and the React app. Bump with the public
# documents; stale registration versions are rejected.
LEGAL_CONSENT_VERSION=2026-11-11

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rifacloud
DB_USERNAME=rifacloud
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
LOG_CHANNEL=stderr
