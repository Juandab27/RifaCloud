APP_NAME=RifaCloud
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rifacloud
DB_USERNAME=rifacloud
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Local development mailer (P1). Mailtrap is only configured at P2 (Q-08).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@rifacloud.local"
MAIL_FROM_NAME="${APP_NAME}"

# Payment provider placeholders. Local development uses the simulated gateway.
# No real credentials are required for P1. The fake gateway is rejected when
# APP_ENV=production.
# PAYMENT_FAKE_OUTCOME: APPROVED, REJECTED, TIMEOUT or UNKNOWN.
PAYMENT_GATEWAY=fake
PAYMENT_FAKE_OUTCOME=UNKNOWN
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Admin bootstrap. The seeder is skipped when these values are empty.
ADMIN_NAME="RifaCloud Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=0000000000

# Technical guard for number generation (not a business rule). See README.
RAFFLE_MAX_NUMBERS=10000

# Reservation duration in minutes (10 per approved SDD) and a technical guard
# for the number of items accepted in a single order (not a business rule).
RESERVATION_MINUTES=10
ORDER_MAX_NUMBERS=50

VITE_APP_NAME="${APP_NAME}"
