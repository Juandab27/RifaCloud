APP_NAME=RifaCloud
APP_ENV=testing
# Test-only key (never used in production). A fresh clone can run the stateful
# test suite without extra steps. Regenerate it with:
#   docker compose exec app php artisan key:generate --env=testing
APP_KEY=base64:O4nOt1u10t/IHxBEResUovGr+ocHTwboRrj0way6AuE=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# The test schema is created by docker/mysql/init/01-test-database.sql.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rifacloud_test
DB_USERNAME=rifacloud
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

BROADCAST_CONNECTION=null
QUEUE_CONNECTION=sync
CACHE_STORE=array

MAIL_MAILER=array
MAIL_FROM_ADDRESS="no-reply@rifacloud.local"
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_GATEWAY=fake
PAYMENT_FAKE_OUTCOME=UNKNOWN
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_TIMEOUT=10
MERCADOPAGO_BACK_URL=

# Keep the admin seeder disabled in tests.
ADMIN_NAME="RifaCloud Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

RAFFLE_MAX_NUMBERS=10000
RESERVATION_MINUTES=10
ORDER_MAX_NUMBERS=50
