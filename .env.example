# Docker Compose variables (local development only).
# Copy this file to .env and replace the placeholders. Never commit .env.
#
# NOTE: docker/mysql/init/01-test-database.sql grants the test schema to the
# user "rifacloud"; keep DB_USERNAME as-is unless you also update that script.

DB_DATABASE=rifacloud
DB_USERNAME=rifacloud
DB_PASSWORD=change-me-local
DB_ROOT_PASSWORD=change-me-root-local
