# Docker Compose variables (local development only).
# Copy this file to .env and replace the placeholders. Never commit .env.
#
# NOTE: docker/mysql/init/01-test-database.sql grants the test schema to the
# user "rifacloud"; keep DB_USERNAME as-is unless you also update that script.
#
# APP_KEY must be non-empty and identical to src/.env APP_KEY: auth-service,
# raffles-service, orders-service and the monolith share the session contract.
# Generate it once with:
#   docker compose run --rm app php artisan key:generate --show
# and paste the same value here and in src/.env.
APP_KEY=

DB_DATABASE=rifacloud
DB_USERNAME=rifacloud
DB_PASSWORD=change-me-local
DB_ROOT_PASSWORD=change-me-root-local

# Least-privilege users required by docker compose (S5/S9.1). They are not
# created by the shared MYSQL_USER. See README "Base de datos local" and
# scripts/mysql-s5-grants.sql; on AWS use deploy/aws/bootstrap-db.sh.
AUTH_DB_USERNAME=rifacloud_auth
AUTH_DB_PASSWORD=change-me-auth-local
RAFFLES_DB_USERNAME=rifacloud_raffles
RAFFLES_DB_PASSWORD=change-me-raffles-local
ORDERS_DB_USERNAME=rifacloud_orders
ORDERS_DB_PASSWORD=change-me-orders-local
PAYMENTS_DB_USERNAME=rifacloud_payments
PAYMENTS_DB_PASSWORD=change-me-payments-local

# Keep the local gateway consistent with src/.env. The production template in
# deploy/aws/env.production.example explicitly uses Mercado Pago.
PAYMENT_GATEWAY=fake
