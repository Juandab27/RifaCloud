# =============================================================================
# RifaCloud - root .gitignore
# =============================================================================

# --- Specification documents: versioned for the university delivery ---
# /docs/sdd/ and /AGENTS.md are intentionally tracked so the SDD and agent
# instructions can be recovered from GitHub. Local agent notes remain ignored.
/src/AGENTS.md
/src/CLAUDE.md

# --- Secrets and environment ---
/.env
/.env.*
!/.env.example
/src/.env
/src/.env.*
!/src/.env.example
!/src/.env.testing.example
*.pem
*.key
*.p12
*.pfx

# --- Installed dependencies ---
/src/vendor/
/services/*/vendor/
/frontend/node_modules/

# --- Service secrets ---
/services/*/.env
/services/*/.env.*
!/services/*/.env.example

# --- AWS deployment generated files (never versioned) ---
/deploy/aws/nginx/https.conf
/deploy/aws/certs/
/deploy/aws/backup.env

# --- Generated builds ---
/frontend/dist/
/frontend/.vite/
/src/public/build/
/src/public/hot
/src/public/storage

# --- Local artifacts and logs ---
*.log
*.sqlite
*.sqlite3
.DS_Store
Thumbs.db
/backups/
/.idea/
/.vscode/

# --- Frontend test artifacts ---
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/
/frontend/.playwright/
