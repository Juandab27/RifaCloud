# RifaCloud backup configuration (copy to /etc/rifacloud/backup.env, chmod 600).
# Do not commit the filled file: deploy/aws/backup.env is ignored by Git.

# Encrypt before upload. Configure exactly one recipient:
BACKUP_GPG_RECIPIENT=
# BACKUP_AGE_RECIPIENT=age1...

BACKUP_DIR=/var/backups/rifacloud
BACKUP_RETENTION_DAYS=14

# Empty disables upload; production should set a private, versioned, SSE-KMS bucket.
BACKUP_S3_URI=s3://YOUR_BUCKET/rifacloud/mysql
