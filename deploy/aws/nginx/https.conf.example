# RifaCloud — direct Nginx TLS example (optional; ALB + ACM is preferred).
#
# This file is a template. Render it with:
#   deploy/aws/render-nginx-tls.sh --domain your.domain --cert /etc/nginx/certs/fullchain.pem --key /etc/nginx/certs/privkey.pem
# Then run docker-compose.prod-tls.yml with the generated file mounted.
#
# Do not commit a rendered copy with a real domain or certificate paths.

server {
    listen 80;
    server_name __APP_DOMAIN__;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __APP_DOMAIN__;

    ssl_certificate __TLS_CERT__;
    ssl_certificate_key __TLS_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    server_tokens off;
    client_max_body_size 10m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    root /usr/share/nginx/html;
    index index.html;

    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location = /api/_raffles_unavailable {
        internal;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        return 503 '{"message":"Catalogo de rifas temporalmente no disponible."}';
    }

    location = /api/_auth_unavailable {
        internal;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        return 503 '{"message":"Servicio de autenticacion temporalmente no disponible."}';
    }

    location = /api/_orders_unavailable {
        internal;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        return 503 '{"message":"Servicio de ordenes temporalmente no disponible."}';
    }

    location = /api/_payments_unavailable {
        internal;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        return 503 '{"message":"Servicio de pagos temporalmente no disponible."}';
    }

    location ^~ /internal/ {
        return 404;
    }

    location ~ ^/api/(register|login|logout|me|auth/health)$ {
        set $auth_upstream auth-service:9000;
        include fastcgi_params;
        fastcgi_pass $auth_upstream;
        fastcgi_param SCRIPT_FILENAME /var/www/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/public;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param PATH_INFO $uri;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_X_FORWARDED_PROTO https;
        fastcgi_connect_timeout 2s;
        fastcgi_read_timeout 10s;
        fastcgi_intercept_errors on;
        error_page 502 503 504 =503 /api/_auth_unavailable;
    }

    location = /sanctum/csrf-cookie {
        set $auth_upstream auth-service:9000;
        include fastcgi_params;
        fastcgi_pass $auth_upstream;
        fastcgi_param SCRIPT_FILENAME /var/www/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/public;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param PATH_INFO $uri;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_X_FORWARDED_PROTO https;
        fastcgi_connect_timeout 2s;
        fastcgi_read_timeout 10s;
        fastcgi_intercept_errors on;
        error_page 502 503 504 =503 /api/_auth_unavailable;
    }

    location ~ ^/api/raffles(?:/[0-9]+(?:/numbers)?)?/?$ {
        set $raffles_upstream raffles-service:80;
        proxy_pass http://$raffles_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        proxy_intercept_errors on;
        error_page 502 503 504 =503 /api/_raffles_unavailable;
    }

    location = /api/admin/raffles/metrics {
        set $raffles_admin_upstream raffles-service:80;
        proxy_pass http://$raffles_admin_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        proxy_intercept_errors on;
        error_page 502 503 504 =503 /api/_raffles_unavailable;
    }

    location ~ ^/api/admin/raffles(?:/.*)?$ {
        set $raffles_admin_upstream raffles-service:80;
        proxy_pass http://$raffles_admin_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
        proxy_intercept_errors off;
        error_page 502 503 504 =503 /api/_raffles_unavailable;
    }

    location = /api/orders {
        set $orders_upstream orders-service:80;
        proxy_pass http://$orders_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
        proxy_intercept_errors off;
        error_page 502 503 504 =503 /api/_orders_unavailable;
    }

    location = /api/admin/orders {
        set $orders_upstream orders-service:80;
        proxy_pass http://$orders_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
        proxy_intercept_errors off;
        error_page 502 503 504 =503 /api/_orders_unavailable;
    }

    location = /api/admin/orders/metrics {
        set $orders_upstream orders-service:80;
        proxy_pass http://$orders_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        proxy_intercept_errors on;
        error_page 502 503 504 =503 /api/_orders_unavailable;
    }

    location ~ ^/api/orders/[0-9]+$ {
        set $orders_upstream orders-service:80;
        proxy_pass http://$orders_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
        proxy_intercept_errors off;
        error_page 502 503 504 =503 /api/_orders_unavailable;
    }

    location = /api/webhooks/mercadopago {
        set $payments_upstream payments-service:80;
        proxy_pass http://$payments_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_send_timeout 25s;
        proxy_read_timeout 25s;
        proxy_intercept_errors off;
        error_page 502 503 504 =503 /api/_payments_unavailable;
    }

    location ~ ^/api/orders/[0-9]+/payments$ {
        set $payments_upstream payments-service:80;
        proxy_pass http://$payments_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_intercept_errors off;
        error_page 502 503 504 =503 /api/_payments_unavailable;
    }

    location ~ ^/api/orders/[0-9]+/payments/[0-9]+/verify$ {
        set $payments_upstream payments-service:80;
        proxy_pass http://$payments_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_intercept_errors off;
        error_page 502 503 504 =503 /api/_payments_unavailable;
    }

    location ~ ^/api/admin/orders/[0-9]+/payments/[0-9]+/resolve$ {
        set $payments_upstream payments-service:80;
        proxy_pass http://$payments_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_intercept_errors off;
        error_page 502 503 504 =503 /api/_payments_unavailable;
    }

    location = /api/admin/payments/incidents/metrics {
        set $payments_upstream payments-service:80;
        proxy_pass http://$payments_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        proxy_intercept_errors on;
        error_page 502 503 504 =503 /api/_payments_unavailable;
    }

    location = /api/admin/payments/incidents {
        set $payments_upstream payments-service:80;
        proxy_pass http://$payments_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
        proxy_intercept_errors off;
        error_page 502 503 504 =503 /api/_payments_unavailable;
    }

    location ~ ^/(api|sanctum)/ {
        include fastcgi_params;
        fastcgi_pass app:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/public;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param PATH_INFO $uri;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_X_FORWARDED_PROTO https;
        fastcgi_read_timeout 60s;
    }

    location / {
        # A location with its own add_header no longer inherits server-level
        # headers, so repeat the HTTPS security headers here.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        try_files $uri $uri/ /index.html;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }
}
