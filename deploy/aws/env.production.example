# =============================================================================
# RifaCloud — plantilla de entorno para AWS EC2 (SIN SECRETOS)
# =============================================================================
# Copia este archivo a .env en la raíz del repositorio en la EC2 y sustituye
# todos los valores vacíos o YOUR_DOMAIN. No lo subas a Git con secretos.
#
# Genera APP_KEY una sola vez:
#   docker compose run --rm app php artisan key:generate --show
#
# El servicio payments-service necesita un src/.env no secreto para satisfacer
# el env_file base de Compose. En la EC2 crea:
#   printf '# production: secrets come from the root .env\n' > src/.env
# No escribas secretos en src/.env.
# =============================================================================

COMPOSE_PROJECT_NAME=rifacloud

# --- Aplicación --------------------------------------------------------------
APP_NAME=RifaCloud
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://YOUR_DOMAIN
APP_DOMAIN=YOUR_DOMAIN

# Para ALB, usa "*" solo si el puerto 80 de la EC2 está restringido al SG del
# ALB. Para Nginx TLS directo, mantén 127.0.0.1,::1.
TRUSTED_PROXIES=127.0.0.1,::1

# --- MySQL -------------------------------------------------------------------
DB_DATABASE=rifacloud
DB_USERNAME=rifacloud
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Usuarios de servicio (mínimo privilegio). Los grants se aplican con
# deploy/aws/bootstrap-db.sh y deploy/aws/grants-production.sql.
AUTH_DB_USERNAME=rifacloud_auth
AUTH_DB_PASSWORD=
RAFFLES_DB_USERNAME=rifacloud_raffles
RAFFLES_DB_PASSWORD=
ORDERS_DB_USERNAME=rifacloud_orders
ORDERS_DB_PASSWORD=
PAYMENTS_DB_USERNAME=rifacloud_payments
PAYMENTS_DB_PASSWORD=

# --- Sesión, CSRF y Sanctum --------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=rifacloud-session
SESSION_DOMAIN=YOUR_DOMAIN
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false
SANCTUM_STATEFUL_DOMAINS=YOUR_DOMAIN
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- Logs --------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Correo ------------------------------------------------------------------
# Mantén "log" hasta validar el proveedor. Cambia a "smtp" solo cuando las
# credenciales y el remitente estén verificados. No se envían correos reales
# con el mailer "log".
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@YOUR_DOMAIN
MAIL_FROM_NAME=RifaCloud

# --- Pagos / Mercado Pago sandbox -------------------------------------------
PAYMENT_GATEWAY=mercadopago
PAYMENT_FAKE_OUTCOME=UNKNOWN
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=https://YOUR_DOMAIN/api/webhooks/mercadopago
# Base URL only: payments-service appends /orders/{id}?pago=retorno.
MERCADOPAGO_BACK_URL=https://YOUR_DOMAIN
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_TIMEOUT=10
ORDERS_INTERNAL_TIMEOUT=5

# --- Reservas ----------------------------------------------------------------
RESERVATION_MINUTES=10
ORDER_MAX_NUMBERS=50
RAFFLE_MAX_NUMBERS=10000

# --- S11: documentos legales y consentimiento --------------------------------
# Bump together with docs/legal/ and frontend/src/lib/legal.ts. The API rejects
# a stale version instead of storing misleading evidence.
LEGAL_CONSENT_VERSION=2026-11-11

# --- Administrador inicial (opcional; vacío = no crear) ----------------------
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=0000000000
